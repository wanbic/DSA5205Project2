    "momentum_63_skip5": {
      "family": "momentum",
      "formula": "adj_close[t-5]/adj_close[t-63]-1"
    },
    "momentum_252_skip21": {
      "family": "momentum",
      "formula": "adj_close[t-21]/adj_close[t-252]-1"
    },
    "day_return_1": {
      "family": "return_components",
      "formula": "adj_close/adj_open-1"
    },
    "day_return_5": {
      "family": "return_components",
      "formula": "exp(sum_5(log(adj_close/adj_open)))-1"
    },
    "day_return_20": {
      "family": "return_components",
      "formula": "exp(sum_20(log(adj_close/adj_open)))-1"
    },
    "night_return_1": {
      "family": "return_components",
      "formula": "adj_open/adj_close.shift(1)-1"
    },
    "night_return_5": {
      "family": "return_components",
      "formula": "exp(sum_5(log(adj_open/adj_close.shift(1))))-1"
    },
    "night_return_20": {
      "family": "return_components",
      "formula": "exp(sum_20(log(adj_open/adj_close.shift(1))))-1"
    },
    "residual_reversal_1": {
      "family": "residual_reversal",
      "formula": "-(ret-beta126_lag1*SPYret)/vol20_lag1"
    },
    "residual_reversal_5": {
      "family": "residual_reversal",
      "formula": "-sum_5(ret-beta126_lag1*SPYret)/(vol20_lag1*sqrt(5))"
    },
    "volatility_20": {
      "family": "risk_liquidity",
      "formula": "std_20(close_returns)"
    },
    "illiquidity_20": {
      "family": "risk_liquidity",
      "formula": "mean_20(abs(close_return)/(raw_vwap*raw_volume))*1e6"
    },
    "relative_dollar_volume": {
      "family": "risk_liquidity",
      "formula": "current_dollars/mean_20(dollars).shift(1)"
    },
    "normalized_alpha041": {
      "family": "price_pressure",
      "formula": "(sqrt(raw_high*raw_low)-raw_vwap)/raw_close"
    },
    "normalized_vwap_reversal": {
      "family": "price_pressure",
      "formula": "(raw_vwap-raw_close)/raw_close"
    },
    "close_location_reversal": {
